# Slash Command Token in Synology Chat, Settings > Apps > Slash Commands
# token you put in Synology Chat must match this one
SYNO_SLASH_TOKEN=YOUR_TOKEN_GENERATED_BY_SYNOLOGY

# Domain of your Jitsi server (without https://)
JITSI_DOMAIN=lsnchat.lifesitenews.com

# Optional: credentials if you use JWT (secure domain)
# You must create an "app" in your Jitsi server with these credentials
# You can leave these empty if your Jitsi server does not use JWT
# If you use JWT, make sure the JITSI_APP_ID and JITSI_APP_SECRET match
# the ones configured in your Jitsi server
JITSI_APP_ID=syno_jitsi_webhook
JITSI_APP_SECRET=super_secret

# Docker image name and tag
IMAGE_NAME=syno-jitsi-webhook
IMAGE_TAG=latest

# Internal Flask server port
APP_PORT=5001
